# =============================================================================
#  Spark Teacher Workspace — Environment Template
#  Copy to .env and fill in values. NEVER commit real secrets.
# =============================================================================

# ---- Node / App ----
NODE_ENV=development
TZ=Asia/Shanghai

# ---- PostgreSQL (docker-compose service: postgres) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=spark_teacher
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spark_teacher_workspace
DATABASE_URL=postgresql://spark_teacher:change-me@localhost:5432/spark_teacher_workspace?schema=public

# ---- Redis (docker-compose service: redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / Object Storage (docker-compose service: minio) ----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=teacher-workspace
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change-me-minio
S3_BUCKET=teacher-workspace
S3_REGION=us-east-1

# ---- JWT / Auth ----
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ---- NestJS API ----
API_HOST=0.0.0.0
API_PORT=3001
API_PREFIX=/api/v1
SWAGGER_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Next.js Web ----
NEXT_PUBLIC_APP_NAME=星火教师操作台
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_NODE_ENV=development

# ---- AI Provider (optional, pick one & fill key) ----
AI_PROVIDER=mock
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
QWY_API_KEY=
QWY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
