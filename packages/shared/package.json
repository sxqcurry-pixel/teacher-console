{
  "name": "@spark/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, DTOs, enums and utilities for Spark Teacher Workspace",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dto": "./src/dto/index.ts",
