{
    "name":  "@spark/shared",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Shared types, DTOs, enums and utilities for Spark Teacher Workspace",
    "main":  "./dist/index.js",
    "types":  "./src/index.ts",
    "exports":  {
                    "./types":  "./dist/types/index.js",
                    "./utils":  "./dist/utils/index.js",
                    "./dto":  "./dist/dto/index.js",
                    "./enums":  "./dist/enums/index.js",
                    ".":  "./dist/index.js"
                },
    "scripts":  {
                    "type-check":  "tsc --noEmit",
                    "build":  "tsc -p tsconfig.json",
                    "clean":  "rimraf dist"
                },
    "devDependencies":  {
                            "typescript":  "^5.7.2"
                        }
}